# ── LiteLLM proxy (recommended) ──────────────────────────────────────────────
# When OPENAI_BASE_URL is set, Azure credentials below are ignored entirely.
OPENAI_BASE_URL=https://bmblx.bmi.osumc.edu/ai/v1
OPENAI_API_KEY=sk-<bioguider-2-virtual-key>
OPENAI_MODEL=gpt-5.4

# ── Azure OpenAI (legacy — used only when OPENAI_BASE_URL is unset) ───────────
# OPENAI_API_TYPE=azure
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# OPENAI_DEPLOYMENT_NAME=<your-deployment>
# OPENAI_API_VERSION=2024-08-01-preview

# ── Token limits ──────────────────────────────────────────────────────────────
OPENAI_MAX_INPUT_TOKENS=128000
OPENAI_MAX_OUTPUT_TOKEN=16384

# ── Embeddings (always Azure; OPENAI_BASE_URL does NOT affect RAG) ────────────
OPENAI_TEXT_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# ── Optional alternative providers ───────────────────────────────────────────
# CLAUDE_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
